 'show2'. Either include them or remove the dependency array.",["238"],["239"],"React Hook useEffect contains a call to 'setprice'. Without a list of dependencies, this can lead to an infinite chain of updates. To fix this, pass [d] as a second argument to the useEffect Hook.",["240"],["241"],"'pro' is assigned a value but never used.","React Hook useEffect has missing dependencies: 'show', 'show2', and 'showreview'. Either include them or remove the dependency array.",["242"],"'saledata' is assigned a value but never used.","'total' is assigned a value but never used.","'settotal' is assigned a value but never used.","'Context' is defined but never used.",["243"],["244"],"'teamMembers' is assigned a value but never used.","'faqs' is assigned a value but never used.","'partnerBrands' is assigned a value but never used.","jsx-a11y/iframe-has-title","<iframe> elements must have a unique title property.",{"desc":"245","fix":"246"},{"desc":"247","fix":"248"},{"desc":"249","fix":"250"},{"desc":"251","fix":"252"},{"desc":"249","fix":"253"},{"desc":"254","fix":"255"},{"desc":"256","fix":"257"},{"desc":"258","fix":"259"},{"desc":"249","fix":"260"},{"desc":"249","fix":"261"},"Add dependencies array: [mail]",{"range":"262","text":"263"},"Update the dependencies array to be: [id, show2]",{"range":"264","text":"265"},"Update the dependencies array to be: [id, show]",{"range":"266","text":"267"},"Update the dependencies array to be: [show, show2]",{"range":"268","text":"269"},{"range":"270","text":"267"},"Add dependencies array: [d]",{"range":"271","text":"272"},"Update the dependencies array to be: [show]",{"range":"273","text":"274"},"Update the dependencies array to be: [prr, show, show2, showreview]",{"range":"275","text":"276"},{"range":"277","text":"267"},{"range":"278","text":"267"},[861,861],", [mail]",[1047,1051],"[id, show2]",[381,385],"[id, show]",[507,509],"[show, show2]",[415,419],[582,582],", [d]",[333,335],"[show]",[1271,1276],"[prr, show, show2, showreview]",[937